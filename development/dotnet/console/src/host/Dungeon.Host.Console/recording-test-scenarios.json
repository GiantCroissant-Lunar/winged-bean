[
  {
    "WorkflowName": "BasicRecordingTest",
    "Rules": [
      {
        "RuleName": "InitialBanner",
        "Expression": "input1.ElapsedSeconds < 0.5",
        "SuccessEvent": "10",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintBanner",
            "Context": {
              "Type": "Banner",
              "Title": "Recording Test Session",
              "SessionId": "{{SessionId}}"
            }
          }
        }
      },
      {
        "RuleName": "PlayerSpawn",
        "Expression": "input1.ElapsedSeconds >= 1 && input1.ElapsedSeconds < 1.5",
        "SuccessEvent": "20",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintGameEvent",
            "Context": {
              "Type": "GameEvent",
              "EventType": "PlayerSpawn",
              "Message": "Player spawns at (5,5)"
            }
          }
        }
      },
      {
        "RuleName": "PlayerMovement",
        "Expression": "input1.ElapsedSeconds >= 2 && input1.ElapsedSeconds < 8 && (input1.ElapsedSeconds % 1) < 0.1",
        "SuccessEvent": "30",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintGameEvent",
            "Context": {
              "Type": "GameEvent",
              "EventType": "PlayerMove",
              "Message": "Player moves"
            }
          }
        }
      },
      {
        "RuleName": "EnemyEncounter",
        "Expression": "input1.ElapsedSeconds >= 3 && input1.ElapsedSeconds < 3.5",
        "SuccessEvent": "40",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintGameEvent",
            "Context": {
              "Type": "GameEvent",
              "EventType": "EnemySpawn",
              "Message": "Enemy detected: Goblin (HP: 20)"
            }
          }
        }
      },
      {
        "RuleName": "CombatEvents",
        "Expression": "input1.ElapsedSeconds >= 4 && input1.ElapsedSeconds < 7 && (input1.ElapsedSeconds % 0.8) < 0.1",
        "SuccessEvent": "50",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintGameEvent",
            "Context": {
              "Type": "GameEvent",
              "EventType": "Combat",
              "Message": "Combat action"
            }
          }
        }
      },
      {
        "RuleName": "FinalSummary",
        "Expression": "input1.ElapsedSeconds >= 9",
        "SuccessEvent": "60",
        "Actions": {
          "OnSuccess": {
            "Name": "PrintSummary",
            "Context": {
              "Type": "Summary",
              "Message": "Test session complete"
            }
          }
        }
      }
    ]
  }
]
