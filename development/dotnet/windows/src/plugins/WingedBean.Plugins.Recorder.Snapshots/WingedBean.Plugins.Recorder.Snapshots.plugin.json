{
  "id": "winged-bean.plugins.recorder.snapshots",
  "name": "URF Recorder for Desktop (WorldSnapshotProvider)",
  "version": "2.0.0",
  "description": "Records game state in Universal Recording Format (URF) with Asciinema export",
  "author": "WingedBean Team",
  "entryPoint": {
    "dotnet": "WingedBean.Plugins.Recorder.Snapshots.dll"
  },
  "loadStrategy": "Eager",
  "priority": 110,
  "dependencies": {
    "plugins": [],
    "nuget": []
  },
  "exports": {
    "services": [
      {
        "interface": "Plate.CrossMilo.Contracts.Recorder.Services.IService",
        "implementation": "WingedBean.Plugins.Recorder.Snapshots.URFRecorderService",
        "lifecycle": "singleton"
      }
    ]
  },
  "compatibility": {
    "minHostVersion": "1.0.0"
  }
}
