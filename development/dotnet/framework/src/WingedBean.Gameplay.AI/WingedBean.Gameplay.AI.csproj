<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WingedBean.Gameplay.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="RulesEngine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Plate.Capability packages -->
    <ProjectReference Include="../../../../../../../plate-projects/capability-orlia/dotnet/src/Plate.Capability.Core/Plate.Capability.Core.csproj" />
    <ProjectReference Include="../../../../../../../plate-projects/capability-orlia/dotnet/src/Plate.Capability.RulesEngine/Plate.Capability.RulesEngine.csproj" />
    <!-- CrossMilo capability contracts (consume evaluator interface) -->
    <ProjectReference Include="../../../../../../../plate-projects/cross-milo/dotnet/framework/src/CrossMilo.Contracts.Capability/CrossMilo.Contracts.Capability.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Examples\goblin-capabilities.json" />
    <EmbeddedResource Include="Examples\player-capabilities.json" />
  </ItemGroup>

</Project>
